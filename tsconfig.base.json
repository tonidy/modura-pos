{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Workspace packages export TypeScript sources, so every package type-checks the
    // engine packages it imports, and the compiler uses Node APIs (hashing, JSON
    // schema loading). The browser app overrides this with its own types.
    "types": ["node"]
  }
}
