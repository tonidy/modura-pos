            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAVAILABLE",
            "x-modura-error-codes": [
              "UNAVAILABLE"
