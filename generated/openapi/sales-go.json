            "x-modura-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "FORBIDDEN",
            "x-modura-error-codes": [
              "FORBIDDEN"
            ]
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "inventory.PRODUCT_NOT_FOUND",
            "x-modura-error-codes": [
              "inventory.PRODUCT_NOT_FOUND"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "RATE_LIMITED",
            "x-modura-error-codes": [
              "RATE_LIMITED"
