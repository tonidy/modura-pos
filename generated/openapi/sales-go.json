        "x-modura-idempotent": false,
        "x-modura-kind": "query",
        "x-modura-operation": "inventory.getStock",
        "x-modura-requires": [
          "inventory.read"
        ]
      }
    },
    "/v1/sales.createSale": {
      "post": {
        "description": "Sell the given products atomically. Prices come from the catalog, never from the client. Lines with the same product are merged before processing.",
        "operationId": "salesCreateSale",
        "parameters": [
          {
            "description": "Unique per attempt, for example per checkout. Retrying with the same key returns the original result.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SalesCreateSaleInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesSale"
                }
              }
            },
            "description": "Success.",
            "headers": {
              "Idempotent-Replayed": {
                "description": "True when this response replays an earlier request with the same idempotency key.",
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_FAILED",
            "x-modura-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAUTHENTICATED",
            "x-modura-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "FORBIDDEN",
            "x-modura-error-codes": [
              "FORBIDDEN"
            ]
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "IDEMPOTENCY_IN_PROGRESS, IDEMPOTENCY_KEY_REUSED",
            "x-modura-error-codes": [
              "IDEMPOTENCY_IN_PROGRESS",
              "IDEMPOTENCY_KEY_REUSED"
            ]
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "sales.INSUFFICIENT_STOCK, sales.PRODUCT_NOT_SELLABLE, sales.UNKNOWN_PRODUCT",
            "x-modura-error-codes": [
              "sales.INSUFFICIENT_STOCK",
              "sales.PRODUCT_NOT_SELLABLE",
              "sales.UNKNOWN_PRODUCT"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "RATE_LIMITED",
            "x-modura-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INTERNAL",
            "x-modura-error-codes": [
              "INTERNAL"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAVAILABLE",
            "x-modura-error-codes": [
              "UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "sales.createSale",
        "tags": [
          "sales"
        ],
        "x-modura-idempotent": true,
        "x-modura-kind": "command",
        "x-modura-operation": "sales.createSale",
        "x-modura-requires": [
          "sales.write"
        ]
      }
    }
  }
}
