{
  "components": {
    "schemas": {
      "CatalogProductId": {
        "description": "Stable product identifier, for example \"prd_flat_white\".",
        "pattern": "^prd_[a-z0-9_]{1,60}$",
        "type": "string"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Platform code or qualified domain code. Clients match on this, never on message.",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amountMinor": {
            "description": "Amount in the currency's minor unit, for example cents.",
            "format": "int64",
            "type": "integer"
          },
          "currency": {
            "description": "ISO 4217 code.",
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "type": "object"
      },
      "ReportsDailySummaryInput": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "$ref": "#/components/schemas/ReportsReportDate"
          }
        },
        "type": "object"
      },
      "ReportsDaySummary": {
        "additionalProperties": false,
        "properties": {
          "asOf": {
            "description": "When the most recent sale this service has processed happened. Missing until the first one arrives.",
            "format": "date-time",
            "type": "string"
          },
          "date": {
            "$ref": "#/components/schemas/ReportsReportDate"
          },
          "itemsSold": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "revenue": {
            "description": "One total per currency; empty when nothing was sold.",
            "items": {
              "$ref": "#/components/schemas/Money"
            },
            "type": "array"
          },
          "salesCount": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "topProducts": {
            "items": {
              "$ref": "#/components/schemas/ReportsProductSales"
            },
            "maxItems": 5,
            "type": "array"
          }
        },
        "required": [
          "date",
          "itemsSold",
          "revenue",
          "salesCount",
          "topProducts"
        ],
        "type": "object"
      },
      "ReportsProductSales": {
        "additionalProperties": false,
        "properties": {
          "productId": {
            "$ref": "#/components/schemas/CatalogProductId"
          },
          "quantity": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "revenue": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "productId",
          "quantity",
          "revenue"
        ],
        "type": "object"
      },
      "ReportsReportDate": {
        "description": "A calendar date in UTC, YYYY-MM-DD.",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "type": "string"
      },
      "ReportsTopProductsInput": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "$ref": "#/components/schemas/ReportsReportDate"
          },
          "limit": {
            "format": "int64",
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "to": {
            "$ref": "#/components/schemas/ReportsReportDate"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "ReportsTopProductsOutput": {
        "additionalProperties": false,
        "properties": {
          "asOf": {
            "description": "When the most recent sale this service has processed happened. Missing until the first one arrives.",
            "format": "date-time",
            "type": "string"
          },
          "from": {
            "$ref": "#/components/schemas/ReportsReportDate"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/ReportsProductSales"
            },
            "maxItems": 20,
            "type": "array"
          },
          "to": {
            "$ref": "#/components/schemas/ReportsReportDate"
          }
        },
        "required": [
          "from",
          "products",
          "to"
        ],
        "type": "object"
      },
      "SalesSaleCompletedEvent": {
        "additionalProperties": false,
        "description": "A sale was committed. Written to the outbox in the same transaction as the sale, delivered at least once.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/SalesSaleId"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/SalesSaleLine"
            },
            "minItems": 1,
            "type": "array"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "createdAt",
          "id",
          "lines",
          "total"
        ],
        "type": "object",
        "x-modura-event": "sales.saleCompleted"
      },
      "SalesSaleId": {
        "description": "Server-generated sale identifier.",
        "pattern": "^sale_[0-9a-z]{1,64}$",
        "type": "string"
      },
      "SalesSaleLine": {
        "additionalProperties": false,
        "properties": {
          "lineTotal": {
            "$ref": "#/components/schemas/Money"
          },
          "productId": {
            "$ref": "#/components/schemas/CatalogProductId"
          },
          "quantity": {
            "format": "int64",
            "maximum": 999,
            "minimum": 1,
            "type": "integer"
          },
          "unitPrice": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "lineTotal",
          "productId",
          "quantity",
          "unitPrice"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Modura POS API: reports-py",
    "version": "0.4.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/reports.dailySummary": {
      "post": {
        "description": "Sales count, items sold, revenue and the top five products for one day (UTC), today by default.",
        "operationId": "reportsDailySummary",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportsDailySummaryInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportsDaySummary"
                }
              }
            },
            "description": "Success."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_FAILED",
            "x-modura-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAUTHENTICATED",
            "x-modura-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "FORBIDDEN",
            "x-modura-error-codes": [
              "FORBIDDEN"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "RATE_LIMITED",
            "x-modura-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INTERNAL",
            "x-modura-error-codes": [
              "INTERNAL"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAVAILABLE",
            "x-modura-error-codes": [
              "UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "reports.dailySummary",
        "tags": [
          "reports"
        ],
        "x-modura-idempotent": false,
        "x-modura-kind": "query",
        "x-modura-operation": "reports.dailySummary",
        "x-modura-requires": [
          "reports.read"
        ]
      }
    },
    "/v1/reports.topProducts": {
      "post": {
        "description": "Best-selling products over a date range (UTC, inclusive), by units sold.",
        "operationId": "reportsTopProducts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportsTopProductsInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportsTopProductsOutput"
                }
              }
            },
            "description": "Success."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_FAILED",
            "x-modura-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAUTHENTICATED",
            "x-modura-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "FORBIDDEN",
            "x-modura-error-codes": [
              "FORBIDDEN"
            ]
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "reports.INVALID_RANGE",
            "x-modura-error-codes": [
              "reports.INVALID_RANGE"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "RATE_LIMITED",
            "x-modura-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INTERNAL",
            "x-modura-error-codes": [
              "INTERNAL"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAVAILABLE",
            "x-modura-error-codes": [
              "UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "reports.topProducts",
        "tags": [
          "reports"
        ],
        "x-modura-idempotent": false,
        "x-modura-kind": "query",
        "x-modura-operation": "reports.topProducts",
        "x-modura-requires": [
          "reports.read"
        ]
      }
    }
  }
}
